{
  "_doc": "Modelle, Stufen, Grenzen und Launcher für scripts/orca_agent.py. Siehe docs/ORCA_AGENT_WORKFLOW.md. Nur Leon ändert die Zuordnung.",
  "backends": {
    "opus": {
      "cli": "claude",
      "model": "opus"
    },
    "glm": {
      "cli": "claude",
      "model": "glm-5.3",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3"
      },
      "key_file": "~/.config/zai/api_key",
      "key_env": "ANTHROPIC_AUTH_TOKEN"
    },
    "gemini": {
      "cli": "agy",
      "model": null,
      "_todo": "Exakten Namen von Gemini Flash 3.8 aus `agy models` eintragen; null = Backend gesperrt. Gemini Pro (3.1) bewusst nicht. Bei Gemini 4 nur diesen Namen tauschen. alphaXiv ist in Antigravity angemeldet."
    }
  },
  "tiers": {
    "light": "gemini",
    "medium": "gemini",
    "heavy": "glm",
    "fallback": "opus"
  },
  "roles": {
    "plan":     {"backend": "opus",       "timeout_min": 60},
    "answer":   {"backend": "opus",       "timeout_min": 8},
    "code":     {"tiered": true, "max_tier": "fallback", "timeout_min": 120},
    "review":   {"tiered": true, "tier_offset": 1, "max_tier": "heavy", "timeout_min": 60},
    "research": {"backend": "gemini",     "timeout_min": 60},
    "audit":    {"backend": "glm",        "timeout_min": 90},
    "upstream": {"backend": "gemini",     "timeout_min": 45}
  },
  "limits": {
    "max_parallel": 5,
    "max_review_rounds": 2,
    "max_plan_revisions": 2,
    "max_no_handoff": 2,
    "max_questions": 3,
    "max_open_ideas": 8,
    "interval_hours": {"research": 24, "audit": 12},
    "cooldown_min": 60,
    "availability_fallback": false
  },
  "orca": {
    "cli": "orca-ide",
    "launcher": "orca",
    "keep_worktree_hours": 12
  }
}
