# Upstream main sync preparation: mirrors Codeberg main to origin/upstream/main and opens one
# `upstream:sync` issue for the agent pipeline. It never merges; see docs/UPSTREAM.md.
# Needs network to Codeberg and gh/git push credentials of user orca (unlike the PR watcher).
#
# Install (as root in CT 105, e.g. from the Proxmox host: pct exec 105 -- bash):
#   cp /home/orca/RadianceMine/scripts/systemd/radiance-upstream-sync.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now radiance-upstream-sync.timer
[Unit]
Description=RadianceMine upstream main sync preparation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orca
Group=orca
WorkingDirectory=/home/orca/RadianceMine
ExecStart=/usr/bin/python3 -u /home/orca/RadianceMine/scripts/upstream_sync.py
StandardOutput=journal
StandardError=journal
