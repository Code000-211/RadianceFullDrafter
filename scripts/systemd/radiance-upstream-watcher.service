# Upstream Codeberg watcher: Jev usefulness triage into candidates/upstream/REVIEW.md.
# It only reads Codeberg + TypeSafe and writes two local files; no GitHub access needed.
#
# Install (as root in CT 105, e.g. from the Proxmox host: pct exec 105 -- bash):
#   cp /home/orca/RadianceMine/scripts/systemd/radiance-upstream-watcher.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now radiance-upstream-watcher
[Unit]
Description=RadianceMine upstream watcher (review list only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orca
Group=orca
WorkingDirectory=/home/orca/RadianceMine
ExecStart=/usr/bin/python3 -u /home/orca/RadianceMine/scripts/watch_upstream.py --daemon --interval 300
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Least privilege: no GitHub credentials, no docker socket, no extra groups,
# writes only to the two directories the watcher owns.
SupplementaryGroups=
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/orca/RadianceMine/telemetry /home/orca/RadianceMine/candidates/upstream
InaccessiblePaths=-/home/orca/.config/gh -/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=multi-user.target
