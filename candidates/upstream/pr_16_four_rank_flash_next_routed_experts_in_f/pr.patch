+    const int64_t k  = gi(p, n_p, "top_k", 0);
+    int64_t g = gi(p, n_p, "group", 0);
+    if (M <= 0 || ne <= 0 || k <= 0) return RAD_E_UNSUPPORTED;
+    int64_t N = 0, K = 0;
+    for (int q = 0; q < 4; ++q) {
