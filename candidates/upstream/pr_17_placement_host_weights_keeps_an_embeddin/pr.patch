              host_budget > 0 ? humanb(host_budget).c_str() : "none",
-             humanb(totals.bytes[(int)Tier::HostPinned]).c_str());
+             humanb(totals.bytes[(int)Tier::HostPinned] - host_weights_bytes).c_str());
     if (totals.bytes[(int)Tier::HostPageable])
