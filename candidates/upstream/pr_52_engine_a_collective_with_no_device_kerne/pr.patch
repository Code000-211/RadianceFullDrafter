 core/config.cpp         |  2 +-
 core/engine_bringup.cpp | 58 ++++++++++++++++++++++++++++++++++++++++-
 docs/GUIDE.md           |  5 ++--
 4 files changed, 63 insertions(+), 6 deletions(-)

