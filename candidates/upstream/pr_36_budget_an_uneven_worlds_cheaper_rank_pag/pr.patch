index 1f63453..d7a96fe 100644
--- a/tests/mem_test.cpp
+++ b/tests/mem_test.cpp
@@ -591,6 +591,63 @@ TEST(kv_a_rank_whose_only_paged_group_is_zero_takes_the_others_block_count) {
