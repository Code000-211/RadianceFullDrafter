+    const int64_t stride = r4d_fp8::lm4a_row_bytes(K, G), ng = K / G;
+    const std::string tag = " [N=" + std::to_string(N) + " K=" + std::to_string(K) +
+                            " M=" + std::to_string(M) + " G=" + std::to_string(G) + "]";
+    std::vector<float> wf((size_t)N * K), xf((size_t)M * K);
