+ * the caches. Prints us and GB/s of weight stream; the point is the MT = 3..4 band. */
+static void lm4_perf(const Plugin& pl, int64_t N, int64_t K, int64_t M, int iters) {
+    const RadKernelInfo* lg = find(pl, "logits_gemm_u4g64");
