+        CHECK_EQ(d.shape[0], 2LL); CHECK_EQ(d.shape[1], 64LL);   /* logical [N,K] */
+        CHECK_EQ(d.fill, (uint32_t)(e2m3 || e2m1 ? RAD_FILL_INDEX : RAD_FILL_NORMAL));
