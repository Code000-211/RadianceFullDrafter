+        for (int64_t c = 0; c < K; ++c)
+            wf[(size_t)r * K + c] =
+                std::ldexp(1.0f, (int)(((r / 128) % 5) * 3 - ((c / 128) % 4)))
+                * (0.031f * (float)((r * 37 + c * 11) % 61) - 0.6f);
