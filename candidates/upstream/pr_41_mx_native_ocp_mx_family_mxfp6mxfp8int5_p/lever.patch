+    st_memset(d_x, 0x3c, (size_t)M * K * 2);
+    std::printf("logits_gemm_u4g64 N=%lld K=%lld M=%lld\n", (long long)N, (long long)K, (long long)M);
+    for (const char* npw : { "1", "2" })
+      for (const char* lean : { "0", "1", "2" })
