+            case 0:  return code;
+            case 1:  return wscale;
+            case 2:  return pairs.empty()  ? nullptr : pairs.data();
+            case 3:  return angle.empty()  ? nullptr : angle.data();
+            case 4:  return tscale.empty() ? nullptr : tscale.data();
