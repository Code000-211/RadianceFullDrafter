+# A plugin like any other: built here inside radiance's tree, or on its own against an installed
+# radiance (`cmake -S arch/qwen35_mxfp6 -B build -DCMAKE_PREFIX_PATH=<radiance prefix>`) -- the
+# same rad_add_plugin either way (cmake/RadAddPlugin.cmake).
+if(NOT COMMAND rad_add_plugin)
+  cmake_minimum_required(VERSION 3.21)
+  project(qwen35_mxfp6 LANGUAGES CXX)
+  find_package(radiance REQUIRED)
+  rad_plugin_defaults()
+endif()
+
+rad_add_plugin(qwen35_mxfp6 architectures SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/qwen35_mxfp6.cpp)
diff --git a/arch/qwen35_mxfp6/qwen35_mxfp6.cpp b/arch/qwen35_mxfp6/qwen35_mxfp6.cpp
new file mode 100644
index 0000000..b2df5b5
--- /dev/null
+++ b/arch/qwen35_mxfp6/qwen35_mxfp6.cpp
@@ -0,0 +1,29 @@
+/* qwen35_mxfp6 -- Qwen3.5 / 3.6 / 3.8 dense, OCP-MX FP6 weights and fp8 activations.
+ *
+ * IT IS arch/qwen35_mxfp4/qwen35_mxfp4.cpp AT A DIFFERENT CODEBOOK, and that is the whole of this
+ * file: four macros and an include -- the qwen35moe pattern. The MX trunk in rad_mx.h reads its
