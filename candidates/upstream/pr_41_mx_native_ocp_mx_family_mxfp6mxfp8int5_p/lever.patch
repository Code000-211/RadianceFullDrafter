+    std::vector<float> hq((size_t)M * K), hun((size_t)M * K), hs(M), hs_un(M);
+    for (int64_t row = 0; row < M; ++row) {
+        std::vector<float> a((size_t)K), au((size_t)K);
+        for (int64_t c = 0; c < K; ++c) {
+            const float v = h_bf16(hx[(size_t)row * K + c]);
