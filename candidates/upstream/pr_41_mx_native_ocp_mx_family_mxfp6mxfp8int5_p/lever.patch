diff --git a/tests/lookup_draft_test.cpp b/tests/lookup_draft_test.cpp
new file mode 100644
index 0000000..49124b3
--- /dev/null
+++ b/tests/lookup_draft_test.cpp
@@ -0,0 +1,297 @@
+/* lookup_draft_test.cpp -- sched/lookup_draft.h: the suffix matcher against an exhaustive reference, the
+ * window and tie rules, the ENTER / STAY / HOT state machine, and what a search costs on the host at 262k. */
+#include "rad_test.h"
+#include "sched/lookup_draft.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+using namespace rad;
+
+namespace {
+
+LookupParams params(int enter, int stay, int hot, int maxm, int min_dist, int chain = 1 << 20) {
+    LookupParams p;
+    p.enabled = true; p.enter = enter; p.stay = stay; p.hot = hot; p.max_match = maxm;
+    p.min_dist = min_dist; p.chain = chain;
+    return p;
+}
+
+/* a view with `split` tokens as the "prompt" and the rest as the "output", as the scheduler holds them */
+TokView view(const std::vector<int32_t>& v, int64_t n, int64_t split) {
+    TokView t;
+    if (split > n) split = n;
+    t.a = v.data(); t.na = split;
+    t.b = v.data() + split; t.nb = n - split;
+    return t;
+}
+
+double now_us() {
+    return std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+}  /* namespace */
+
+TEST(lookup_matcher_equals_the_exhaustive_scan_on_random_text) {
+    struct Cfg { int alpha, enter, stay, maxm, min_dist; };
+    const Cfg cfgs[] = { {2, 8, 3, 24, 1}, {3, 8, 3, 24, 7}, {5, 8, 3, 24, 40}, {5, 4, 2, 6, 5},
+                         {50, 8, 3, 24, 40}, {4, 3, 3, 24, 16}, {2, 8, 8, 24, 0}, {7, 12, 1, 24, 100} };
+    std::mt19937 rng(12345);
+    for (const Cfg& c : cfgs) {
+        for (int trial = 0; trial < 6; ++trial) {
+            const int N = 700;
+            std::vector<int32_t> seq((size_t)N);
+            /* random text with planted repeats, so long matches exist */
+            for (int i = 0; i < N; ++i) {
+                if (i > 60 && rng() % 100 < 3) {
+                    const int len = 5 + (int)(rng() % 40), src = (int)(rng() % (uint32_t)(i - 20));
+                    for (int j = 0; j < len && i < N; ++j, ++i) seq[(size_t)i] = seq[(size_t)(src + j)];
+                    --i;
+                } else {
+                    seq[(size_t)i] = 100 + (int32_t)(rng() % (uint32_t)c.alpha);
+                }
+            }
+            const LookupParams p = params(c.enter, c.stay, 3, c.maxm, c.min_dist);
+            const int64_t split = (int64_t)(rng() % 300);
+            LookupIndex ix;
+            int bad = 0;
+            for (int64_t n = 1; n <= N; ++n) {
+                /* sometimes skip a search: the index must catch up */
+                if (n % 5 == 0 && rng() % 3 == 0) continue;
+                const TokView t = view(seq, n, split);
+                int rm; int64_t rp;
+                lookup_ref_best(t, p.min_match(), p.max_match, c.min_dist, &rm, &rp);
+                int64_t gp = 0;
+                const int gm = ix.search(t, p, c.min_dist, &gp);
+                if (gm != rm || (rm > 0 && gp != rp)) {
+                    if (++bad <= 3)
+                        std::fprintf(stderr, "    alpha %d n %lld: index (%d, %lld) ref (%d, %lld)\n", c.alpha,
+                                     (long long)n, gm, (long long)gp, rm, (long long)rp);
+                }
+            }
+            CHECK_EQ(bad, 0);
+        }
+    }
+}
+
+TEST(lookup_matcher_takes_only_sources_further_back_than_the_window) {
+    /* A 10-token pattern at 0..9 and again at 100..109; the sequence ends with the pattern's first 9
+     * tokens at 150..158 (n = 159). Continuation of the match at p=9 starts 150 back, of the one at
+     * p=109 start 50 back. */
+    std::vector<int32_t> s((size_t)159, 0);
+    for (size_t i = 0; i < s.size(); ++i) s[i] = 7000 + (int32_t)(i * 13 % 211);   /* background */
+    for (int j = 0; j < 9; ++j) { s[(size_t)j] = 1 + j; s[(size_t)(100 + j)] = 1 + j; s[(size_t)(150 + j)] = 1 + j; }
+    s[9] = 50; s[109] = 60;
+    const TokView t = view(s, 159, 20);
+    int64_t p = 0;
+    {   /* the window is 40: the nearer copy (continuation 50 back) is legal and more recent */
+        LookupIndex ix;
+        CHECK_EQ(ix.search(t, params(8, 3, 3, 24, 40), 40, &p), 9);
+        CHECK_EQ((int)p, 109);
+    }
+    {   /* the window is 100: the nearer copy is the drafter's, the far one is taken */
+        LookupIndex ix;
+        CHECK_EQ(ix.search(t, params(8, 3, 3, 24, 100), 100, &p), 9);
+        CHECK_EQ((int)p, 9);
+    }
+    {   /* the window is 200: nothing is far enough */
+        LookupIndex ix;
+        CHECK_EQ(ix.search(t, params(8, 3, 3, 24, 200), 200, &p), 0);
+    }
+    {   /* the boundary: a continuation exactly min_dist back is legal, one token closer is not */
+        LookupIndex ix;
+        CHECK_EQ(ix.search(t, params(8, 3, 3, 24, 150), 150, &p), 9);
+        CHECK_EQ((int)p, 9);
+        LookupIndex iy;
+        CHECK_EQ(iy.search(t, params(8, 3, 3, 24, 151), 151, &p), 0);
+    }
+}
+
+TEST(lookup_matcher_prefers_the_longer_match_then_the_most_recent) {
+    /* three earlier copies of an 8-token suffix: at 20 (extended to 11 by the tokens before it), at 60 and
+     * at 100 (both 8 long); the sequence ends at 160. */
+    std::vector<int32_t> s((size_t)160, 0);
+    for (size_t i = 0; i < s.size(); ++i) s[i] = 9000 + (int32_t)(i * 31 % 307);
+    const int32_t suf[8] = { 11, 12, 13, 14, 15, 16, 17, 18 };
+    for (int j = 0; j < 8; ++j) { s[(size_t)(152 + j)] = suf[j]; s[(size_t)(12 + j)] = suf[j]; s[(size_t)(52 + j)] = suf[j];
+                                  s[(size_t)(92 + j)] = suf[j]; }
+    /* the match at 12..19 also agrees on the three tokens before the suffix: make them equal */
+    for (int j = 1; j <= 3; ++j) { s[(size_t)(152 - j)] = 500 + j; s[(size_t)(12 - j)] = 500 + j; }
+    const TokView t = view(s, 160, 0);
+    int64_t p = 0;
+    LookupIndex ix;
+    CHECK_EQ(ix.search(t, params(8, 3, 3, 24, 30), 30, &p), 11);   /* longest wins although older */
+    CHECK_EQ((int)p, 20);
+    /* without the longer one the most recent of the two equal ones wins */
+    s[(size_t)(12 - 1)] = 1;
+    LookupIndex iy;
+    CHECK_EQ(iy.search(view(s, 160, 0), params(8, 3, 3, 24, 30), 30, &p), 8);
+    CHECK_EQ((int)p, 100);
+    /* max_match caps the length; a capped match found first is the most recent one */
+    LookupIndex iz;
+    CHECK_EQ(iz.search(view(s, 160, 0), params(8, 3, 3, 8, 30), 30, &p), 8);
+    CHECK_EQ((int)p, 100);
+}
+
+TEST(lookup_policy_enters_at_enter_and_stays_at_stay_only_after_a_hot_step) {
+    const LookupParams p = params(8, 3, 3, 24, 2048);
+    CHECK(!lookup_use(p, 0, false));
+    CHECK(!lookup_use(p, 7, false));
+    CHECK(lookup_use(p, 8, false));
+    CHECK(!lookup_use(p, 2, true));
+    CHECK(lookup_use(p, 3, true));
+    CHECK(lookup_use(p, 24, true));
+
+    LookupMode m;
+    CHECK(!m.decide(p, 5));            /* a short match does not enter */
+    CHECK(m.decide(p, 8));             /* a long one does */
+    m.verified(p, 7);                  /* accepted 7 >= HOT: hot */
+    CHECK(m.hot);
+    CHECK(m.decide(p, 3));             /* ... so STAY is enough */
+    m.verified(p, 2);                  /* accepted 2 < HOT: cold again */
+    CHECK(!m.hot);
+    CHECK(!m.decide(p, 5));            /* back to ENTER */
+    CHECK(m.decide(p, 9));
+    m.verified(p, 3);                  /* exactly HOT counts */
+    CHECK(m.hot);
+    CHECK(!m.decide(p, 2));            /* hot but no match >= STAY: drafter's proposal, mode left */
+    CHECK(!m.used);
+    m.verified(p, 0);                  /* a step that carried the drafter's proposal never makes it hot */
+    CHECK(!m.hot);
+    CHECK(!m.decide(p, 4));
+    /* hot is consumed by one decision: a second one without a verify in between is cold */
+    CHECK(m.decide(p, 8));
+    m.verified(p, 6);
+    CHECK(m.decide(p, 4));
+    CHECK(!m.decide(p, 4));
+}
+
+TEST(lookup_params_from_env_validate) {
+    LookupParams p = params(8, 3, 3, 24, -1);
+    CHECK(p.valid());
+    p.enter = 2; p.stay = 3;           /* ENTER < STAY would never enter on what STAY keeps */
+    CHECK(!p.valid());
+    p = params(25, 3, 3, 24, -1);
+    CHECK(!p.valid());                 /* ENTER above the match cap can never be met */
+    p = params(8, 3, 0, 24, -1);
+    CHECK(!p.valid());
+}
+
+TEST(lookup_matcher_cost_on_the_host_at_262k) {
+    /* natural-ish text: a Zipf-like token distribution (frequent short n-grams, which stress the chains),
+     * a far copy planted every so often. The drafter's window is 2048. */
+    const int64_t N = 262144;
+    const int64_t MD = 2048;
+    std::mt19937 rng(7);
+    std::vector<int32_t> seq((size_t)N);
+    auto zipf = [&]() {
+        const double u = (double)(rng() % 1000000) / 1e6;
+        return 1000 + (int32_t)(std::pow(u, 3.0) * 6000.0);
+    };
+    for (int64_t i = 0; i < N; ++i) {
+        if (i > 10000 && rng() % 2000 == 0) {
+            const int len = 30 + (int)(rng() % 200);
+            const int64_t src = (int64_t)(rng() % (uint32_t)(i - 5000));
+            for (int j = 0; j < len && i < N; ++j, ++i) seq[(size_t)i] = seq[(size_t)(src + j)];
+            --i;
+        } else {
+            seq[(size_t)i] = zipf();
+        }
+    }
+    const LookupParams p = params(8, 3, 3, 24, MD, 1024);
+
+    /* (1) the first search over a 262k history: builds the whole index once */
+    {
+        LookupIndex ix;
+        int64_t pos = 0;
+        const double t0 = now_us();
+        (void)ix.search(view(seq, N - 4, 200000), p, MD, &pos);
+        const double dt = now_us() - t0;
+        std::fprintf(stderr, "    first search over %lld tokens (index build): %.1f ms, index %.1f MB\n",
+                     (long long)(N - 4), dt / 1e3, (double)ix.memory_bytes() / 1048576.0);
+        CHECK(dt < 100e3);
+    }
+    /* (2) the steady state: the sequence grows by 1..8 tokens a step (a verify step commits 1 + accepted),
+     * one search per step, from 254k to 262k. Three texts: the Zipf one above, a phrase-bank text (repeated
+     * phrases of 3..12 tokens out of 2000: many frequent n-grams and long matches, like code or prose with
+     * quotations) and uniform random tokens (nothing ever matches). */
+    std::vector<int32_t> bank_text((size_t)N), uniform((size_t)N);
+    {
+        std::vector<std::vector<int32_t>> bank(2000);
+        for (auto& ph : bank) {
+            ph.resize(3 + rng() % 10);
+            for (auto& t : ph) t = 1000 + (int32_t)(rng() % 20000);
+        }
+        for (int64_t i = 0; i < N;) {
+            const auto& ph = bank[(size_t)(std::pow((double)(rng() % 100000) / 1e5, 2.0) * 1999.0)];
+            for (size_t j = 0; j < ph.size() && i < N; ++j, ++i) bank_text[(size_t)i] = ph[j];
+            if (rng() % 4 == 0 && i < N) bank_text[(size_t)i++] = 1000 + (int32_t)(rng() % 20000);
+        }
+        for (auto& t : uniform) t = 1000 + (int32_t)(rng() % 150000);
+    }
+    struct Text { const char* name; const std::vector<int32_t>* v; };
+    for (const Text& tx : { Text{"zipf", &seq}, Text{"phrase bank", &bank_text}, Text{"uniform", &uniform} }) {
+        LookupIndex ix;
+        int64_t pos = 0;
+        int64_t n = N - 8192;
+        (void)ix.search(view(*tx.v, n, 4000), p, MD, &pos);
+        std::vector<double> us;
+        double vis = 0;
+        int hits = 0;
+        while (n + 8 <= N) {
+            n += 1 + (int64_t)(rng() % 8);
+            const double t0 = now_us();
+            const int m = ix.search(view(*tx.v, n, 4000), p, MD, &pos);
+            us.push_back(now_us() - t0);
+            vis += ix.last_visited();
+            hits += m > 0;
+        }
+        std::sort(us.begin(), us.end());
+        double mean = 0;
+        for (double x : us) mean += x;
+        mean /= (double)us.size();
+        std::fprintf(stderr, "    steady search at ~254k..262k, %-11s: mean %.2f us, p50 %.2f, p99 %.2f, max %.2f us "
+                             "(%zu steps, %.1f candidates a search, %d matches)\n", tx.name, mean, us[us.size() / 2],
+                     us[us.size() * 99 / 100], us.back(), us.size(), vis / (double)us.size(), hits);
+        CHECK(mean < 200.0);
+        CHECK(us.back() < 20000.0);
+    }
+    /* (3) worst cases for a chain: one token repeated, and a period-2 text, each at 262k */
+    for (int kind = 0; kind < 2; ++kind) {
+        std::vector<int32_t> w((size_t)N);
+        for (int64_t i = 0; i < N; ++i) w[(size_t)i] = kind == 0 ? 5 : 5 + (int32_t)(i & 1);
+        LookupIndex ix;
+        int64_t pos = 0;
+        int64_t n = N - 4096;
+        (void)ix.search(view(w, n, 100), p, MD, &pos);
+        double worst = 0, sum = 0;
+        int cnt = 0;
+        while (n + 8 <= N) {
+            n += 4;
+            const double t0 = now_us();
+            (void)ix.search(view(w, n, 100), p, MD, &pos);
+            const double dt = now_us() - t0;
+            worst = std::max(worst, dt); sum += dt; ++cnt;
+        }
+        std::fprintf(stderr, "    degenerate text (%s): mean %.2f us, max %.2f us\n",
+                     kind == 0 ? "one token" : "period 2", sum / cnt, worst);
+        CHECK(sum / cnt < 200.0);
+    }
+    /* (4) a sequence that is no longer than the window costs nothing: the index is never built */
+    {
+        LookupIndex ix;
+        int64_t pos = 0;
+        const double t0 = now_us();
+        for (int64_t n = 100; n < MD; n += 3) (void)ix.search(view(seq, n, 50), p, MD, &pos);
+        std::fprintf(stderr, "    %d searches under the window: %.1f us total, indexed %lld\n", (int)((MD - 100) / 3),
+                     now_us() - t0, (long long)ix.indexed());
+        CHECK(ix.empty());
+    }
+}
+
+RAD_TEST_MAIN()
diff --git a/tests/r4d_bands_test.cpp b/tests/r4d_bands_test.cpp
new file mode 100644
index 0000000..5e65834
--- /dev/null
+++ b/tests/r4d_bands_test.cpp
@@ -0,0 +1,225 @@
+/* r4d_bands_test.cpp -- libr4d's gemm_nt_q rows against core/plugin/bands.cpp's rules, on the host.
+ *
+ * The real row table is read out of libr4d.so with dlopen/dlsym, exactly as rad-schemas does: no
+ * device is opened and nothing is launched. The band table is rebuilt here from the same rule
+ * bands.cpp states (boundaries = LE / GE-1 / EQ-1,EQ of EVERY row of the op, each band resolved at
+ * its upper bound) and rows are matched with the core's own constraint_holds, highest priority
+ * first, ties to the earlier row.
+ *
+ * WHY: constraints of one row are AND-ed, so a band edge placed on a real row narrows that row. An
+ * `M <= 16` on the decode row would make it serve M <= 16 only and push M 17..64 onto the tiled
+ * kernel (a 4-5x slower GEMM). The edges now sit on gemm_nt_q_bands, a row that matches no tensor.
+ * This test holds both halves of that: the band list, and that our decode row is what every band up
+ * to 64 resolves to and our tiled row what every band above it resolves to.
+ *
+ * THE RUNTIME SWITCH. The native decode/tiled rows (gemm_mxfp4a8_decode / gemm_mxfp4a8_tiled) are
+ * the "tuned bands": they carry the ks/bk/nt and tn/dec tune axes. RADIANCE_MX_TUNE=1 raises them at
+ * row registration, so one binary serves both and the same test is run twice for an A/B:
+ *
+ *     ./r4d_bands_test                                  # default: our rows win
+ *     RADIANCE_MX_TUNE=1 ./r4d_bands_test               # tuned: the ported PR rows win
+ *
+ * The .so reads the environment when the row table is first built, which is the dlopen this test
+ * performs, so the expected row names follow the environment. Unset/0 is byte-for-byte today's
+ * behaviour and is what ctest runs.
+ */
+#include "rad_test.h"
+#include "rad_abi.h"
+#include "rad_internal.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace rad;
+
+namespace {
+
+/* The tuned rows this switch selects, and the default rows they stand against. `hyb` is the
+ * M-banded decode hybrid's low bound: when PR decode is selected the PR decode row is narrowed to
+ * M >= hyb+1 (RADIANCE_MX_HYBRID_M, default 16), so bands at or below `hyb` resolve to our own
+ * gemm_mxfp4a8_nt_m64 and every band above still resolves to the PR decode row. */
+struct Names {
+    const char* decode;
+    const char* tiled;
+    bool tuned;
+    long long hyb;
+};
+
+Names expected_names() {
+    const char* t = std::getenv("RADIANCE_MX_TUNE");
+    const char* e = std::getenv("RADIANCE_MX_GEMM");
+    const char* h = std::getenv("RADIANCE_MX_HYBRID_M");
+    const bool tune = t && t[0] && std::strcmp(t, "0") != 0;
+    const bool pr_dec = tune || (e && e[0] && (std::strstr(e, "pr_decode") || std::strstr(e, "ablk")));
+    const bool pr_til = tune || (e && e[0] && (std::strstr(e, "pr_tiled")  || std::strstr(e, "ablk")));
+    long long hyb = pr_dec ? 16 : 0;
+    if (h && h[0]) hyb = std::strtoll(h, nullptr, 10);
+    if (!pr_dec || hyb <= 0 || hyb >= 128) hyb = 0;
+    /* Upstream's native decode row is the default for the whole M <= 128 band (its MXDEC priority
+     * outranks the skinny row), so both switches leave the same row names -- they only move the
+     * priority. The M-banded hybrid, when pr_dec is set, narrows the decode row to M >= hyb+1 so
+     * the low bands fall back to our gemm_mxfp4a8_nt_m64. */
+    return Names{ "gemm_mxfp4a8_decode", "gemm_mxfp4a8_tiled", pr_dec || pr_til, hyb };
+}
+
+struct Rows {
+    void* h = nullptr;
+    std::vector<const RadKernelInfo*> gemm;     /* op gemm_nt_q, declaration order */
+};
+
+bool open_rows(Rows* out) {
+    std::string path;
+    if (const char* p = std::getenv("RAD_R4D_SO")) path = p;
+    else {
+        const char* h = std::getenv("RADIANCE_HOME");
+        path = std::string(h ? h : "radiance_home") + "/kernels/libr4d.so";
+    }
+    if (access(path.c_str(), R_OK) != 0) {
+        fprintf(stderr, "  SKIP no libr4d.so at %s\n", path.c_str());
+        return false;
+    }
+    out->h = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!out->h) { fprintf(stderr, "  SKIP dlopen(%s): %s\n", path.c_str(), dlerror()); return false; }
+    auto cnt = (int (*)(void))dlsym(out->h, "rad_kernel_count");
+    auto at  = (const RadKernelInfo* (*)(int))dlsym(out->h, "rad_kernel_at");
+    if (!cnt || !at) { fprintf(stderr, "  SKIP %s is not a kernel plugin\n", path.c_str()); return false; }
+    for (int i = 0, n = cnt(); i < n; ++i) {
+        const RadKernelInfo* k = at(i);
+        if (k && k->op && std::string(k->op) == "gemm_nt_q" && k->domain == RAD_DOMAIN_DEVICE)
+            out->gemm.push_back(k);
+    }
+    return true;
+}
+
+const RadKernelInfo* by_name(const Rows& r, const char* name) {
+    for (const RadKernelInfo* k : r.gemm) if (std::string(k->name) == name) return k;
+    return nullptr;
+}
+
+/* bands.cpp's boundary rule, over [lo, hi]. */
+std::vector<long long> edges(const Rows& r, long long lo, long long hi) {
+    std::vector<long long> b;
+    auto add = [&](long long v) { if (v >= lo && v < hi) b.push_back(v); };
+    for (const RadKernelInfo* k : r.gemm)
+        for (int i = 0; i < k->n_constraints; ++i) {
+            const RadConstraint& c = k->constraints[i];
+            if (!c.key || std::string(c.key) != "M") continue;
+            if (c.op == RAD_C_LE) add(c.ival);
+            else if (c.op == RAD_C_GE) add(c.ival - 1);
+            else if (c.op == RAD_C_EQ) { add(c.ival - 1); add(c.ival); }
+        }
+    std::sort(b.begin(), b.end());
+    b.erase(std::unique(b.begin(), b.end()), b.end());
+    b.push_back(hi);
+    return b;
+}
+
+/* select.cpp's rule: every constraint holds, highest priority wins, a tie goes to the earlier row. */
+const RadKernelInfo* resolve(const Rows& r, const Geometry& g) {
+    const RadKernelInfo* best = nullptr;
+    for (const RadKernelInfo* k : r.gemm) {
+        bool ok = true;
+        for (int i = 0; i < k->n_constraints && ok; ++i) ok = constraint_holds(k->constraints[i], g);
+        if (ok && (!best || k->priority > best->priority)) best = k;
+    }
+    return best;
+}
+
+Geometry geom(const char* dtype, long long M) {
+    Geometry g;
+    g.set_i("M", M); g.set_i("N", 4096); g.set_i("K", 4096); g.set_s("dtype", dtype);
+    return g;
+}
+
+}  /* namespace */
+
+TEST(gemm_nt_q_band_list) {
+    Rows r;
+    if (!open_rows(&r)) return;
+    /* The union of every gemm_nt_q row's LE / GE-1 / EQ-1,EQ on M, plus the gemm_nt_q_bands edges:
+     * the ordinary rows already say 8 (fp8a16 m16), 16 (bf16 m16) and 64 (every decode row), and the
+     * bands row adds 32, 48, 128, 256, 512, 1024 and 2048. */
+    const std::vector<long long> want = { 8, 16, 32, 48, 64, 128, 256, 512, 1024, 2048, 8192 };
+    CHECK(edges(r, 1, 8192) == want);
+}
+
+TEST(mxfp4a8_rows_serve_their_bands) {
+    Rows r;
+    if (!open_rows(&r)) return;
+    const Names n = expected_names();
+    printf("mode: %s (decode=%s tiled=%s)\n", n.tuned ? "RADIANCE_MX_TUNE" : "default",
+           n.decode, n.tiled);
+    long long prev = 0;
+    for (long long hi : edges(r, 1, 8192)) {
+        const RadKernelInfo* k = resolve(r, geom("mxfp4a8", hi));
+        const std::string name = k ? k->name : "(none)";
+        /* one line per band, for tools/scripts that want to show it (a script can grep "^band ") */
+        printf("band M in (%lld, %lld] -> %s\n", prev, hi, name.c_str());
+        prev = hi;
+        /* The M-banded hybrid: at or below `hyb` the PR decode row is excluded and ours wins. */
+        const char* dec_hi = (n.hyb > 0 && hi <= n.hyb) ? "gemm_mxfp4a8_nt_m64" : n.decode;
+        if (hi <= 128) CHECK_EQ(name, dec_hi);
+        else          CHECK_EQ(name, n.tiled);
+    }
+    /* and every single M in between, not only the band tops */
+    for (long long m = 1; m <= 128; ++m) {
+        const char* dec_m = (n.hyb > 0 && m <= n.hyb) ? "gemm_mxfp4a8_nt_m64" : n.decode;
+        CHECK_EQ(std::string(resolve(r, geom("mxfp4a8", m))->name), dec_m);
+    }
+}
+
+/* A row that exists only to carry band edges must be unselectable for every dtype any tensor has,
+ * and must never outrank anything even if it were reached. */
+TEST(band_edge_row_is_inert) {
+    Rows r;
+    if (!open_rows(&r)) return;
+    const RadKernelInfo* bands = by_name(r, "gemm_nt_q_bands");
+    REQUIRE(bands != nullptr);
+    CHECK(bands->launch != nullptr);
+    CHECK_EQ(bands->priority, 0);
+    for (const RadKernelInfo* k : r.gemm) CHECK(k == bands || k->priority > bands->priority);
+    for (const char* dt : { "mxfp4a8", "mxfp8a8", "mxfp6a8", "w4a16", "w8a16", "w4a8",
+                            "w4a8_asym", "w8a8", "w5a8", "w2a8", "bf16", "fp8a16", "fp8a8",
+                            "i8a8", "f16", "int8", "" })
+        for (long long m : { 1LL, 16LL, 48LL, 64LL, 2048LL, 8192LL }) {
+            const RadKernelInfo* k = resolve(r, geom(dt, m));
+            CHECK(!k || std::string(k->name) != "gemm_nt_q_bands");
+        }
+}
+
+/* The wide decode form (dec=1) reads a row-major A. Where the producer can write A fragment-tiled
+ * (afrag = T <= the band's upper bound M) the tiled row's tune_valid must refuse it, so a dec=1 tune
+ * line cannot meet the atiled kernel's layout. Our gemm_nt_q schema does not declare `afrag` (the
+ * fragment-tiled A producers are not ported), but tune_valid reads it straight off the geometry, so
+ * the guard is exercised here even though no op in this tree supplies it. Both tiled rows carry the
+ * same test; the tuned row is checked when RADIANCE_MX_TUNE is on. */
+TEST(tiled_row_refuses_wide_form_with_fragment_plane) {
+    Rows r;
+    if (!open_rows(&r)) return;
+    const char* name = expected_names().tiled;
+    const RadKernelInfo* tiled = by_name(r, name);
+    REQUIRE(tiled != nullptr);
+    REQUIRE(tiled->tune_valid != nullptr);
+    auto legal = [&](long long M, long long afrag, long long dec) {
+        Geometry g = geom("mxfp4a8", M);
+        if (afrag) g.set_i("afrag", afrag);
+        RadParam c{};
+        c.key = "dec"; c.kind = RAD_P_INT; c.ival = dec;
+        return tiled->tune_valid(g.params(), g.n_params(), &c, 1) == 1;
+    };
+    CHECK(legal(128, 0, 1));        /* no fragment plane: the wide form is fine */
+    CHECK(legal(128, 513, 1));      /* T above the band: no M of it is tiled */
+    CHECK(!legal(128, 100, 1));     /* band reaches T */
+    CHECK(!legal(128, 128, 1));     /* T == upper bound */
+    CHECK(legal(64, 200, 1));       /* band is below T */
+    CHECK(!legal(256, 0, 1));       /* wide form stops at 128 (the native decode's band) */
+    CHECK(legal(128, 100, 0));      /* dec=0 is the tiled kernel, whatever T */
+    CHECK(legal(2048, 513, 0));
+}
+
+RAD_TEST_MAIN()
