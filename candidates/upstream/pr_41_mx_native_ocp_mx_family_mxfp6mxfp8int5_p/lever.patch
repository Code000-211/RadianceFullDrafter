+    const void* wscale = nullptr;                   /* enc plane 1: E8M0 exponents */
+    std::vector<uint8_t> pairs;                     /* enc plane 2: i32 [S, K] global pairs */
+    std::vector<uint8_t> angle;                     /* enc plane 3: f32 [S, K/2] angles */
