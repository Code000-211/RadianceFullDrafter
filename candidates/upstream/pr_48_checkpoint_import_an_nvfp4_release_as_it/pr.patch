+rad-convert ~/models/unsloth/Qwen3.8-27B-NVFP4 --draft-model ~/models/z-lab/Qwen3.8-27B-DFlash2 \
+    --recipe data/recipes/q38-27b-nvfp4-df2.recipe -o q38-27b-nvfp4-df2.rad
+
