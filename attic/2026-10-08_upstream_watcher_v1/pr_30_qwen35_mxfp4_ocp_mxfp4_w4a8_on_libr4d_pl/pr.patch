+  if (TN != 2 && TN != 4) throw std::runtime_error("r4d gemm_mxfp4a8_atiled: TN must be 2 or 4");
+  if (as_group != 0 && as_group != 128)
+    throw std::runtime_error("r4d gemm_mxfp4a8_atiled: the activation scale is per row or per 128 of K");
