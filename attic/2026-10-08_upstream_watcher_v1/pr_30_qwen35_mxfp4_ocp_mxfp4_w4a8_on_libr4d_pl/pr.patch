+# OCP-MXFP4 instead of block fp8, served through qwen35_mxfp4.
+#
+#   rad-convert <Swift-1.5-Qwen3.8-27b-heretic MXFP4A16 checkpoint, see q38-27b-mxfp4.recipe> --draft-model <incoai/Qwen3.8-27B-DFlash2> \
+#       --recipe data/recipes/q38-27b-mxfp4-df2mx.recipe -o q38-27b-mxfp4-df2mx.rad
