+static inline int mx_ascale_grid(const GemmOps& g, int* group, int* rs) {
+    const RadTensor* s = g.ascale;
+    if (!s || g.M <= 0) return R4D_NO(RAD_E_INVAL);
+    long long cols = 1, rstride = 1;
+    if (s->rank >= 2) {
