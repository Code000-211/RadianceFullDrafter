+    const int wire = w.wire;
+
     R4dArCfg cfgv;
     r4d_cfg_ar(a, &cfgv);
     const long words16 = (long)(M * n * 2 / 16);
@@ -1239,3 +1286,41 @@ extern "C" int r4d_rad_ar_hc_write(const RadArgs* a, RadStream s) {
                         nblocks, cfgv.nthreads, cfgv.drain, cfgv.acq));
