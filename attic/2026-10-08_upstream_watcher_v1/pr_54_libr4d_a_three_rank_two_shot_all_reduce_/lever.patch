     C_DIV("numel", 64), C_GE("numel", R4D_AR_WIDE_ONESHOT_MAX_ELEMS + 1),
@@ -4345,6 +4352,20 @@ static const RadKernelInfo kKernels[] = {
 
 /* ---------------------------------------------------------------------------- all-reduce ----
