+                        rad_weight w, rad_weight bias) {
+            return RAD_OP(b, "gemm_nt_bias",
+                RAD_PARAMS(RAD_RANGE("M", 1, rows), RAD_INT("N", N), RAD_INT("K", K),
+                           RAD_STR("dtype", "bf16"), RAD_STR("act", nonlinearity)), RAD_WEIGHTS(w, bias));
+        };
