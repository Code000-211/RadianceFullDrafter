+            RAD_ISSUE_N(c, l.contract, n, brows(ff, n), RAD_W(l.down), RAD_W(l.down_bias), RAD_NONE, brows(h, n));
+            RAD_ISSUE_N(c, residual, n, brows(h, n), brows(x, n), brows(x, n));
