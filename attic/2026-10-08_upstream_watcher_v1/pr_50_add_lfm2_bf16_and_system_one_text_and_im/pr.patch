+    CHECK_EQ(whole.device_rows->spans.size(), 1u);
+    auto lease = whole.device_rows;
+    static_cast<uint16_t*>(lease->spans[0].data)[0] = 1234;
+    bb.fini();
+    CHECK_EQ(static_cast<uint16_t*>(lease->spans[0].data)[0], 1234);
