+    if (s == "<|img_row_9_col_7|>") return {124994};
+    if (s == "<|img_row_9_col_8|>") return {124995};
+    if (s == "<|img_row_9_col_9|>") return {124996};
+    if (s == "<|img_thumbnail|>") return {125008};
+    return {};
+}
