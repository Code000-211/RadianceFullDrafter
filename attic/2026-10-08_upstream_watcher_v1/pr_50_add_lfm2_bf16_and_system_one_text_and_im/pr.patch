+TEST(retained_media_budget_is_opt_in_capped_and_charged_only_to_rank_zero) {
+    Fixture f;
+    f.build(64, 32, 64, 262144);
+    f.prog.encoder.modalities = RAD_MM_IMAGE;
+    f.prog.encoder.patch_dim = 3;
