+            in.v = pa[i];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) out.s[e] = f2bf(bf2f(in.s[e]) * psc[i] * (pw[e] + wadd));
+            *(uint4*)(sA + (ar + i * kRS) * kTAP + k8a) = out.v;
+        }
+#pragma unroll
+        for (int b = 0; b < kBV; ++b) {
+            const long idx = tid + (long)b * NTH;
+            if (idx < nbv) sB[idx] = pb[b];
