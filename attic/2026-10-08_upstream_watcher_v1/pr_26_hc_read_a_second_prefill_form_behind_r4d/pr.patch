+    bool live[NW];
+#pragma unroll
+    for (int i = 0; i < NW; ++i) live[i] = ng + i * kWaves < ntt;
+    v8f acc[MW][NW];
+#pragma unroll
+    for (int m = 0; m < MW; ++m)
+#pragma unroll
+        for (int i = 0; i < NW; ++i) acc[m][i] = (v8f){0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+
+    fetch(0);
+    for (long t = 0; t < nsl; ++t) {
+        __syncthreads();
+        stage();
+        __syncthreads();
+        fetch((t + 1 < nsl) ? t + 1 : t);       /* the last slice re-reads itself: no branch */
