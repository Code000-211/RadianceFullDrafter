     c.id = opt_.model_id;
     c.created = started_at_;
     c.max_model_len = opt_.max_ctx;
+    c.root = opt_.model_path;
     metrics_.observe_http(200);
     return HttpResponse::json_body(200, id.empty() ? models_body(c) : model_body(c));
 }
diff --git a/core/server/server.h b/core/server/server.h
index 782dd10..5336af2 100644
--- a/core/server/server.h
+++ b/core/server/server.h
@@ -57,6 +57,10 @@ struct ServerOptions {
