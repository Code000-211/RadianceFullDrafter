From a8eec8c2ffc285de7d3ca8a34ffb99bf8179ceb2 Mon Sep 17 00:00:00 2001
From: baKon <mike.ski83@gmail.com>
Date: Wed, 7 Oct 2026 13:53:19 -0500
Subject: [PATCH 2/4] serve: /v1/models/:id answers the model object, not a
 list of one

OpenAI's retrieve returns the entry itself, and its SDK reads `id` off the top level, where
the list of one this route answered before has none. /v1/models still answers the list.
---
 core/server/oai.cpp    | 18 +++++++++++++-----
 core/server/oai.h      | 24 +++++++++++++++++-------
 core/server/server.cpp |  6 +++++-
 docs/GUIDE.md          |  2 +-
 tests/server_test.cpp  | 17 +++++++++++------
 tests/wire_test.cpp    | 20 ++++++++++++++++++--
 6 files changed, 65 insertions(+), 22 deletions(-)

diff --git a/core/server/oai.cpp b/core/server/oai.cpp
index c0a3205..75a26e0 100644
--- a/core/server/oai.cpp
+++ b/core/server/oai.cpp
@@ -2205,19 +2205,27 @@ std::string embeddings_body(const OaiRequest& r, const std::vector<std::vector<f
     return o.dump();
 }
 
-std::string models_body(const std::string& model_id, int64_t created, int64_t max_model_len) {
+static json model_card(const ModelCard& c) {
     json m;
-    m["id"] = model_id;
+    m["id"] = c.id;
     m["object"] = "model";
-    m["created"] = created;
+    m["created"] = c.created;
     m["owned_by"] = "radiance";
-    if (max_model_len > 0) m["max_model_len"] = max_model_len;
+    if (c.max_model_len > 0) m["max_model_len"] = c.max_model_len;
+    return m;
+}
+
+std::string models_body(const ModelCard& c) {
     json o;
     o["object"] = "list";
-    o["data"] = json::array({m});
+    o["data"] = json::array({model_card(c)});
     return o.dump();
 }
 
+std::string model_body(const ModelCard& c) {
+    return model_card(c).dump();
+}
+
 /* ================================================================== SSE */
 
 std::string sse_event(const std::string& json_text) {
diff --git a/core/server/oai.h b/core/server/oai.h
index 3aa5fa6..0dc2694 100644
--- a/core/server/oai.h
+++ b/core/server/oai.h
@@ -318,13 +318,23 @@ std::string text_completion_body(const OaiRequest& r, const std::vector<ChoiceOu
                                  const UsageOut& u, const TimingsOut& t = TimingsOut());
 std::string embeddings_body(const OaiRequest& r, const std::vector<std::vector<float>>& vecs,
                             const UsageOut& u);
-/* `max_model_len` is the context the server was started with (--max-model-len, else the
- * container's trained length), the field vLLM's model card carries. Clients size their own
- * context from it -- an agent that compresses its history at the window's edge, a UI that shows
- * how much is left -- and without it they guess from the model's name, which is wrong whenever the
- * deployment sets its own length. 0 leaves the field out rather than reporting a length the
- * server does not know. */
-std::string models_body(const std::string& model_id, int64_t created, int64_t max_model_len = 0);
+/* ONE MODEL ENTRY: what /v1/models lists and /v1/models/:id returns on its own. */
+struct ModelCard {
+    std::string id;
+    int64_t     created = 0;
+    /* The context the server was started with (--max-model-len, else the container's trained
+     * length), the field vLLM's model card carries. Clients size their own context from it -- an
+     * agent that compresses its history at the window's edge, a UI that shows how much is left --
+     * and without it they guess from the model's name, which is wrong whenever the deployment sets
+     * its own length. 0 leaves the field out rather than reporting a length the server does not
+     * know. */
+    int64_t     max_model_len = 0;
+};
+/* The list, for GET /v1/models. */
+std::string models_body(const ModelCard& m);
+/* The entry itself, for GET /v1/models/:id: OpenAI's retrieve answers the model object, not a
+ * list of one, and its SDK reads `id` off the top level. */
+std::string model_body(const ModelCard& m);
 
 /* The usage chunk of each endpoint's stream: an SSE event whose choices array is empty and whose
  * only payload is `usage`. Emitted when the request asked for stream_options.include_usage, ONCE
diff --git a/core/server/server.cpp b/core/server/server.cpp
index 21f5f90..f3dfd35 100644
--- a/core/server/server.cpp
+++ b/core/server/server.cpp
@@ -1152,8 +1152,12 @@ HttpResponse Server::handle_models(const HttpRequest& req) {
         e.message = "no such model: " + id;
         return error_response(e, req.peer);
     }
+    ModelCard c;
+    c.id = opt_.model_id;
+    c.created = started_at_;
+    c.max_model_len = opt_.max_ctx;
     metrics_.observe_http(200);
-    return HttpResponse::json_body(200, models_body(opt_.model_id, started_at_, opt_.max_ctx));
+    return HttpResponse::json_body(200, id.empty() ? models_body(c) : model_body(c));
 }
 
 HttpResponse Server::handle_metrics(const HttpRequest&) {
