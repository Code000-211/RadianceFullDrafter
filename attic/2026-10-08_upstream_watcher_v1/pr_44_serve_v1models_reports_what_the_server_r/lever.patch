From 7328fd73419abf4c1a756e7d1f32d8ab08bf89ee Mon Sep 17 00:00:00 2001
From: baKon <mike.ski83@gmail.com>
Date: Wed, 7 Oct 2026 13:54:11 -0500
Subject: [PATCH 3/4] serve: the model entry names the file behind the served
 name as root

A served name is chosen for clients and says nothing about which container is behind it.
Report what --model named as `root`, the field vLLM fills with the path it loaded; left out
when the server has none.
---
 core/engine.cpp        | 1 +
 core/server/oai.cpp    | 1 +
 core/server/oai.h      | 2 ++
 core/server/server.cpp | 1 +
 core/server/server.h   | 4 ++++
 docs/GUIDE.md          | 2 +-
 tests/server_test.cpp  | 7 +++++--
 tests/wire_test.cpp    | 7 +++++++
 8 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/core/engine.cpp b/core/engine.cpp
index b98d4fb..67293bb 100644
--- a/core/engine.cpp
+++ b/core/engine.cpp
@@ -2264,6 +2264,7 @@ int Engine::run_server() {
      * more choices a request; the floor keeps a small batch from refusing what it would queue. */
     o.max_n    = cfg_.max_n > 0 ? (int)cfg_.max_n : (int)std::max<int64_t>(o.max_n, cfg_.max_seqs);
     o.max_ctx  = cfg_.max_ctx ? cfg_.max_ctx : meta_.n_ctx_train;
+    o.model_path = cfg_.model;
     o.default_reasoning_effort = cfg_.reasoning_effort;
     o.reasoning_effort_map = cfg_.reasoning_effort_map;
     o.default_thinking_budget = cfg_.thinking_token_budget;
diff --git a/core/server/oai.cpp b/core/server/oai.cpp
index 75a26e0..5c6f666 100644
--- a/core/server/oai.cpp
+++ b/core/server/oai.cpp
@@ -2212,6 +2212,7 @@ static json model_card(const ModelCard& c) {
     m["created"] = c.created;
     m["owned_by"] = "radiance";
     if (c.max_model_len > 0) m["max_model_len"] = c.max_model_len;
+    if (!c.root.empty()) m["root"] = c.root;
     return m;
 }
 
diff --git a/core/server/oai.h b/core/server/oai.h
index 0dc2694..334661a 100644
--- a/core/server/oai.h
+++ b/core/server/oai.h
@@ -329,6 +329,8 @@ struct ModelCard {
      * its own length. 0 leaves the field out rather than reporting a length the server does not
      * know. */
     int64_t     max_model_len = 0;
+    /* What the server loaded (ServerOptions::model_path), vLLM's `root`. Empty leaves it out. */
+    std::string root;
 };
 /* The list, for GET /v1/models. */
 std::string models_body(const ModelCard& m);
diff --git a/core/server/server.cpp b/core/server/server.cpp
